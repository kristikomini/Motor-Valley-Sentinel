{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": { "value": "mvsentinel" },
    "imageTag": { "value": "latest" },
    "acrLoginServer": { "value": "REPLACE_ME.azurecr.io" },
    "postgresAdminUser": { "value": "mvadmin" },
    "postgresAdminPassword": {
      "reference": {
        "keyVault": { "id": "/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/<vault>" },
        "secretName": "postgres-admin-password"
      }
    }
  }
}
