# Motor Valley Monitor - Environment variables for local development
# Copy this file to .env and adjust as needed

# Kafka (when running producer/processor locally)
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Producer
SENSOR_TOPIC=sensor-data
NUM_MACHINES=120
INTERVAL_SECONDS=0.5

# Processor
ALERTS_TOPIC=critical-alerts

# Backend (in appsettings.json or env)
# Database provider: "Postgres" (default) or "Oracle"
# Database__Provider=Postgres
# ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=motorvalley;Username=postgres;Password=postgres
# ConnectionStrings__Oracle=User Id=motorvalley;Password=motorvalley;Data Source=localhost:1521/XEPDB1
# ConnectionStrings__Redis=localhost:6380
# Azure SignalR backplane (empty = in-process SignalR, used for local dev)
# ConnectionStrings__AzureSignalR=

# Frontend (when running with Vite proxy)
# VITE_API_TARGET defaults to http://localhost:5000
